  "integration_fixes": [
    {
      "id": "FIX-1",
      "title": "config/default.json 带 UTF-8 BOM → 默认配置整体失效",
      "detail": "config/default.json 被重写时引入 BOM，sidecar/config.py 的 load_defaults() 以 encoding='utf-8' 读取，JSONDecodeError 被静默吞掉返回 {}，所有默认配置（injection/prune/llm/day 等）丢失。修复：default.json 重写为无 BOM + load_defaults/parse_override 改 utf-8-sig 双保险；回归断言：test_tokens.DefaultConfigTest（无 BOM + totalHardTokens=3000 等默认值）。",
      "status": "fixed"
    },
    {
      "id": "FIX-2",
      "title": "graph.py 候选选择缺陷：图谱 20000 节点时高相似节点被漏召回（D3 注入量漂移 15.9%）",
      "detail": "graph.py `_candidate_ids` 只取 8 个最小倒排桶做候选，20k 节点时桶被 bulk 噪声占满，100 个高相似固定记忆节点一个都进不了候选，retrieve 注入 token 差 15.9%（D3 硬指标 17 不达标）。修复：名字词法倒排（ASCII 词 + CJK 2-gram）∪ 哈希维度倒排（遍历全部 query 维度，cap 调优），并补 graph.py 缺失的 `import re`（名字倒排 NameError）。回归：test_D3_graph_scale_constant_budget。",
      "status": "fixed"
    },
    {
      "id": "FIX-3",
      "title": "server.py 未知方法返回 -32603（RpcError 关键字参数用错，-32601 永远出不来）",
      "detail": "dispatch 里 `RpcError(..., code=-32601)`，但 base.RpcError 形参是 rpc_code，TypeError 被通用 except 捕获成 -32603 internal error，违反 CONTRACT §3 错误码约定。修复：改为 rpc_code=-32601。回归：test_protocol.test_unknown_method_32601。",
      "status": "fixed"
    },
    {
      "id": "FIX-4",
      "title": "noise.py 凭据正则漏 Bearer token（凭据可能进图谱/日志）",
      "detail": "CONTRACT §2.3 要求凭据正则覆盖 `Bearer\\s+\\S+`；实测 `Authorization: Bearer abcdef123456.token` 因命中数字放行信号而 passed（未丢弃）。修复：新增大小写不敏感 Bearer 模式（含数字≥8 字符或无数字≥20 字符），同时保证普通英文 `bearer token is required` 不误伤。回归：test_F4_credential_dropped_and_alarm。",
      "status": "fixed"
    },
    {
      "id": "FIX-5",
      "title": "ingest 同名实体 upsert 绕过改口检测（C 场景旧说法仍可检索）",
      "detail": "Day2 「我现在不喜欢喝咖啡了，改成喝茶」抽出的候选名与 Day1 同名，service.ingest 走「已有同名实体 → 追加 description」短路，未进入 supersede 判定：description 变旧+新拼接、无 Journal supersede、旧值仍被检索（违反 R6）。验收探针发现后由实现方修复；现回归：test_C_supersede_daily（description/valid_from=Day2/w=max/protect_until+7d/Journal/rollback/R6 全链路）。",
      "status": "fixed"
    }
  ],
